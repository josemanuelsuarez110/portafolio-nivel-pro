# Database Configuration
# Local Docker (default): postgresql://user_pro:password_pro@db:5432/level_pro_db
# Local machine (manual): postgresql://user_pro:password_pro@localhost:5432/level_pro_db
# Supabase: postgresql://postgres:[password]@[host]:5432/postgres
DATABASE_URL=postgresql://user_pro:password_pro@db:5432/level_pro_db

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Server Port
PORT=8000
